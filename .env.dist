# Copy to .env, fill the REQUIRED lines, then run ./scripts/generate-secrets.sh (see README, "Install on a server").

# Compose file used by `docker compose` on a server (the local files stay for development).
COMPOSE_FILE=docker-compose.production.yml

# --- REQUIRED: compose refuses to start while one of these is empty ---
# Host name of the UI and API (DNS must point to your server).
REDLINE_UI_HOST=
# Host name of the artboards: a different origin from the UI, covered by the same certificate setup. Not behind the SSO: each URL carries a viewing capability.
REDLINE_ARTBOARD_HOST=
# Traefik middleware of your SSO (applied to the UI host only; share links /s/* skip it), as Traefik names it (e.g. authelia@docker, authentik@file, oauth2-proxy@docker).
REDLINE_AUTH_MIDDLEWARE=
# E-mail of the SSO person who becomes the first admin (the SSO must send exactly this e-mail for them, set by the SSO admin and not editable by the users).
REDLINE_FIRST_ADMIN_EMAIL=

# --- Traefik ---
# Prefix of every router, service and middleware name (must be unique on the host's Traefik).
REDLINE_TRAEFIK_PREFIX=redline
# External Docker network shared with Traefik.
REDLINE_TRAEFIK_NETWORK=traefik
REDLINE_ENTRYPOINT_HTTP=web
REDLINE_ENTRYPOINT_HTTPS=websecure
REDLINE_CERT_RESOLVER=letsencrypt

# --- Identity headers sent by your SSO (defaults: Authelia) ---
REDLINE_IDENTITY_HEADER_USER=Remote-User
REDLINE_IDENTITY_HEADER_NAME=Remote-Name
REDLINE_IDENTITY_HEADER_EMAIL=Remote-Email
# Where "Se déconnecter" leads: the logout page of your SSO.
REDLINE_LOGOUT_URL=https://auth.example.com/logout

TZ=Europe/Paris

# --- Proxy secrets: written by ./scripts/generate-secrets.sh, never edit by hand ---
# Required by compose; empty until the generator has run.
REDLINE_PROXY_SECRET_HUMAN=
REDLINE_PROXY_SECRET_MACHINE=
