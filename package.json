{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/agent",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "demo": "tsx --tsconfig scripts/tsconfig.json scripts/demo.ts",
    "test:docker": "REDLINE_DOCKER_TEST=1 vitest run packages/server/test/docker.test.ts packages/server/test/production-compose.test.ts packages/server/test/backup-restore.test.ts",
    "eval:agent": "tsx --tsconfig scripts/tsconfig.json scripts/eval-agent.ts",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
